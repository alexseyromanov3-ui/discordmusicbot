# Discord Bot Token (obtain from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Idle timeout before the bot disconnects from voice channel (in seconds)
IDLE_TIMEOUT=300

# Default playback volume (0.0 to 2.0, where 1.0 is 100%)
DEFAULT_VOLUME=0.5

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional explicit path to ffmpeg executable (leave empty for auto-detection)
FFMPEG_PATH=

# Optional path to cookies file (e.g. cookies.txt) or browser name for age-restricted 18+ YouTube videos
# Place cookies.txt in the bot folder or specify path below:
YOUTUBE_COOKIEFILE=
# Or use cookies from installed browser: chrome, edge, firefox, etc.
YOUTUBE_COOKIES_BROWSER=
